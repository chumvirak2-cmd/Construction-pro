# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe Dashboard (Monthly)
STRIPE_STARTER_MONTHLY_ID=price_...
STRIPE_PRO_MONTHLY_ID=price_...
STRIPE_ENTERPRISE_MONTHLY_ID=price_...

# Price IDs from Stripe Dashboard (Yearly)
STRIPE_STARTER_YEARLY_ID=price_...
STRIPE_PRO_YEARLY_ID=price_...
STRIPE_ENTERPRISE_YEARLY_ID=price_...

# App URL for webhook redirects
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Sheets Backend
# Create a Google Cloud service account, enable the Google Sheets API, and share the spreadsheet with the service account email.
# Paste the service account JSON as one line.
GOOGLE_SHEETS_CREDENTIALS='{"type":"service_account","project_id":"","private_key_id":"","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@project.iam.gserviceaccount.com","client_id":"","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40project.iam.gserviceaccount.com"}'
GOOGLE_SHEETS_SPREADSHEET_ID=

# ABA Payway Configuration (OPTIONAL - for Cambodia payments)
# Get these from ABA Payway Merchant Portal: https://payway.ababank.com/merchant
NEXT_PUBLIC_ABA_MERCHANT_ID=
NEXT_PUBLIC_ABA_SERVICE_CODE=
ABA_PAYWAY_API_KEY=
ABA_WEBHOOK_SECRET=

# MySQL / Google Cloud SQL
# Connection pool settings for Cloud SQL (MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=construction_pro
# Cloud SQL connection name: PROJECT:REGION:INSTANCE
# Example: my-project:asia-southeast1:construction-pro-db
GOOGLE_CLOUD_SQL_CONNECTION_NAME=
